{
  "name": "darukaa-earth",
  "private": true,
  "scripts": {
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2"
  },
  "lint-staged": {
    "frontend/src/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "frontend/src/**/*.css": [
      "prettier --write"
    ],
    "backend/**/*.py": [
      "black",
      "ruff check --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
